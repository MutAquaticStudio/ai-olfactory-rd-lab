# Private model bundle. Keep these files outside the Git repository.
SCENT_STUDIO_RESOURCE_DIR=/Users/your-user/.scent-molecule-studio/resources

# Optional retrosynthesis evidence. The result is not a synthesis guarantee.
# SCENT_STUDIO_AIZYNTH_CONFIG=/absolute/path/to/aizynthfinder.yml

# Optional private SQLite/Parquet data root for Data intake.
SCENT_STUDIO_DATA_DIR=/Users/your-user/.scent-molecule-studio

# Optional five-seed Chemprop research model. It is shown only in Analysis →
# Technical details and requires the separate training environment at runtime.
# SCENT_STUDIO_JUDGE_SHADOW_MANIFEST=/absolute/path/to/ensemble_manifest.json

# Optional Boltz receptor-binding research provider. Start with a workspace TEST
# key: test mode returns synthetic results and does not incur GPU/billing costs.
# Never commit a live or test key to Git.
# BOLTZ_API_KEY=sk_bc_ws_test_...
# BOLTZ_BASE_URL=https://api.boltz.bio
# BOLTZ_REQUEST_TIMEOUT_SECONDS=30
